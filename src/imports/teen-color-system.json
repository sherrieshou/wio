{
  "teen_color_system": {
    "name": "Teen Spectral Glow",
    "description": "Soft atmospheric glow representing the Teen participant in the conversation visualizer",
    
    "colors": {
      "center": "#8B7BDA",
      "middle_glow": "#E6B4EA",
      "outer_glow": "#F3EBA5",
      "transparent_edge": "rgba(243,235,165,0)"
    },

    "gradient": {
      "type": "radial",
      "stops": [
        {
          "color": "#8B7BDA",
          "position": 0,
          "opacity": 0.9
        },
        {
          "color": "#8B7BDA",
          "position": 0.25,
          "opacity": 0.7
        },
        {
          "color": "#E6B4EA",
          "position": 0.45,
          "opacity": 0.6
        },
        {
          "color": "#F3EBA5",
          "position": 0.7,
          "opacity": 0.35
        },
        {
          "color": "#F3EBA5",
          "position": 0.9,
          "opacity": 0.12
        },
        {
          "color": "#F3EBA5",
          "position": 1.0,
          "opacity": 0
        }
      ]
    },

    "visual_effects": {
      "blur_radius": {
        "min": 100,
        "max": 140,
        "unit": "px"
      },
      "blend_mode": "screen",
      "edge_behavior": "no_visible_boundary"
    },

    "usage": {
      "element": "trajectory_point_glow",
      "style": "soft_blob",
      "notes": [
        "Glow should resemble diffused colored light",
        "Avoid solid circular edges",
        "Allow overlapping glows to mix colors naturally"
      ]
    }
  }
}